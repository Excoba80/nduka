extends ../../layouts/main

block content

    .container-fluid

        //- Page Header
        .d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-center.mb-4

            div
                h1.h3.fw-bold.mb-1
                    i.bi.bi-file-earmark-text.me-2
                    | Investigation Request

                p.text-muted.mb-0
                    | #{request.request_reference}

            div.mt-3.mt-md-0.d-flex.flex-wrap.gap-2

                if request.status === 'PENDING' && hasPermission('review_investigation_request')

                    form(
                        method="POST"
                        action=`/investigation-requests/${request.id}/accept`
                    )

                        input(
                            type="hidden"
                            name="_csrf"
                            value=csrfToken
                        )

                        button.btn.btn-success(
                            type="submit"
                        )
                            i.bi.bi-check-circle.me-2
                            | Accept Request


                    button.btn.btn-outline-danger(
                        type="button"
                        data-bs-toggle="modal"
                        data-bs-target="#rejectInvestigationRequestModal"
                    )
                        i.bi.bi-x-circle.me-2
                        | Reject Request


                a.btn.btn-outline-secondary(
                    href="/investigation-requests"
                )
                    i.bi.bi-arrow-left.me-2
                    | Back to Investigation Requests


        //- Request Overview
        .card.shadow-sm.border-0.rounded-4.mb-4

            .card-body.p-4

                .d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-start

                    div
                        h2.h4.fw-bold.mb-2
                            | #{request.case_title}

                        div.text-muted
                            | #{request.request_reference}

                    div.mt-3.mt-md-0

                        if request.status === 'PENDING'
                            span.badge.text-bg-warning.fs-6
                                | Pending

                        else if request.status === 'ACCEPTED'
                            span.badge.text-bg-success.fs-6
                                | Accepted

                        else if request.status === 'REJECTED'
                            span.badge.text-bg-danger.fs-6
                                | Rejected

                        else
                            span.badge.text-bg-secondary.fs-6
                                | #{request.status}


        //- Request Workflow
        .card.shadow-sm.border-0.rounded-4.mb-4

            .card-header.bg-white.border-0.pt-4.px-4

                h5.fw-bold.mb-0
                    i.bi.bi-diagram-3.me-2.text-primary
                    | Request Workflow


            .card-body.p-4

                if request.status === 'PENDING'

                    .alert.alert-warning.mb-0

                        .d-flex.align-items-start

                            i.bi.bi-hourglass-split.fs-4.me-3

                            div

                                h6.fw-bold.mb-1
                                    | Awaiting Review

                                p.mb-0
                                    | This Investigation Request has been submitted and is awaiting review by NDUKA.


                else if request.status === 'ACCEPTED'

                    .alert.alert-success.mb-0

                        .d-flex.align-items-start

                            i.bi.bi-check-circle.fs-4.me-3

                            div

                                h6.fw-bold.mb-1
                                    | Request Accepted

                                p.mb-2
                                    | This Investigation Request has been reviewed and accepted.

                                p.mb-0
                                    | The request is now awaiting the next payment stage. A Client and Case will be created only after the required payment workflow is completed.


                else if request.status === 'REJECTED'

                    .alert.alert-danger.mb-0

                        .d-flex.align-items-start

                            i.bi.bi-x-circle.fs-4.me-3

                            div

                                h6.fw-bold.mb-1
                                    | Request Rejected

                                p.mb-0
                                    | This Investigation Request was not approved for progression into the investigation workflow.


                else

                    .alert.alert-secondary.mb-0

                        .d-flex.align-items-start

                            i.bi.bi-info-circle.fs-4.me-3

                            div

                                h6.fw-bold.mb-1
                                    | Current Request Status

                                p.mb-0
                                    | #{request.status}




        //- Applicant and Subject Information
        .row.g-4.mb-4

            .col-12.col-lg-6

                .card.shadow-sm.border-0.rounded-4.h-100

                    .card-header.bg-white.border-0.pt-4.px-4

                        h5.fw-bold.mb-0
                            i.bi.bi-person.me-2.text-primary
                            | Applicant Information

                    .card-body.p-4

                        .row.g-4

                            .col-12

                                small.text-muted.d-block.mb-1
                                    | Applicant Name

                                .fw-semibold
                                    | #{request.applicant_name}


                            .col-12.col-md-6

                                small.text-muted.d-block.mb-1
                                    | Phone

                                if request.applicant_phone
                                    .fw-semibold
                                        | #{request.applicant_phone}

                                else
                                    span.text-muted
                                        | Not provided


                            .col-12.col-md-6

                                small.text-muted.d-block.mb-1
                                    | Email

                                if request.applicant_email
                                    .fw-semibold
                                        | #{request.applicant_email}

                                else
                                    span.text-muted
                                        | Not provided


                            .col-12

                                small.text-muted.d-block.mb-1
                                    | Address

                                if request.address_line_1
                                    .fw-semibold
                                        | #{request.address_line_1}

                                if request.address_line_2
                                    .d-block
                                        | #{request.address_line_2}

                                if request.city || request.state || request.country
                                    .d-block
                                        = [request.city, request.state, request.country].filter(Boolean).join(', ')

                                if request.postal_code
                                    .d-block
                                        | #{request.postal_code}

                                if !request.address_line_1 && !request.address_line_2 && !request.city && !request.state && !request.country && !request.postal_code
                                    span.text-muted
                                        | Not provided


            .col-12.col-lg-6

                .card.shadow-sm.border-0.rounded-4.h-100

                    .card-header.bg-white.border-0.pt-4.px-4

                        h5.fw-bold.mb-0
                            i.bi.bi-person-badge.me-2.text-primary
                            | Subject Information

                    .card-body.p-4

                        .row.g-4

                            .col-12

                                small.text-muted.d-block.mb-1
                                    | Subject Name

                                .fw-semibold
                                    | #{request.subject_name}


                            .col-12.col-md-6

                                small.text-muted.d-block.mb-1
                                    | Phone

                                if request.subject_phone
                                    .fw-semibold
                                        | #{request.subject_phone}

                                else
                                    span.text-muted
                                        | Not provided


                            .col-12.col-md-6

                                small.text-muted.d-block.mb-1
                                    | Email

                                if request.subject_email
                                    .fw-semibold
                                        | #{request.subject_email}

                                else
                                    span.text-muted
                                        | Not provided


        //- Request Information
        .card.shadow-sm.border-0.rounded-4.mb-4

            .card-header.bg-white.border-0.pt-4.px-4

                h5.fw-bold.mb-0
                    i.bi.bi-info-circle.me-2.text-primary
                    | Request Information

            .card-body.p-4

                .row.g-4

                    .col-12.col-md-6

                        small.text-muted.d-block.mb-1
                            | Client Type

                        .fw-semibold
                            | #{request.client_type_name}

                        if request.client_type_description
                            .small.text-muted.mt-1
                                | #{request.client_type_description}


                    .col-12.col-md-6

                        small.text-muted.d-block.mb-1
                            | Submitted

                        if request.created_at
                            .fw-semibold
                                = new Date(request.created_at).toLocaleString()

                        else
                            span.text-muted
                                | Not available


                    .col-12

                        small.text-muted.d-block.mb-1
                            | Case Title

                        .fw-semibold.fs-5
                            | #{request.case_title}


                    .col-12

                        small.text-muted.d-block.mb-2
                            | Investigation Purpose

                        .p-3.bg-light.rounded
                            | #{request.investigation_purpose}


                    if request.additional_information

                        .col-12

                            small.text-muted.d-block.mb-2
                                | Additional Information

                            .p-3.bg-light.rounded
                                | #{request.additional_information}


                    .col-12

                        small.text-muted.d-block.mb-1
                            | Consent

                        if request.consent_confirmed
                            span.badge.text-bg-success
                                i.bi.bi-check-circle.me-1
                                | Confirmed

                        else
                            span.badge.text-bg-danger
                                i.bi.bi-x-circle.me-1
                                | Not Confirmed


        //- Requested Investigation Services
        .card.shadow-sm.border-0.rounded-4.mb-4

            .card-header.bg-white.border-0.pt-4.px-4

                h5.fw-bold.mb-0
                    i.bi.bi-search.me-2.text-primary
                    | Requested Investigation Services

            .card-body.p-4

                if request.services && request.services.length

                    each service in request.services

                        .card.border.mb-4

                            .card-header.bg-light

                                h6.fw-bold.mb-1
                                    | #{service.investigation_type_name}

                                if service.investigation_type_code
                                    small.text-muted
                                        | #{service.investigation_type_code}

                                if service.investigation_type_description
                                    p.text-muted.small.mb-0.mt-1
                                        | #{service.investigation_type_description}


                            .card-body

                                if service.fields && service.fields.length

                                    .row.g-4

                                        each field in service.fields

                                            .col-12.col-md-6

                                                small.text-muted.d-block.mb-1
                                                    | #{field.field_label}

                                                if field.field_value !== null && field.field_value !== undefined && String(field.field_value).trim()

                                                    if field.field_type === 'CHECKBOX' && Array.isArray(field.field_value)
                                                        .fw-semibold
                                                            | #{field.field_value.join(', ')}

                                                    else
                                                        .fw-semibold
                                                            | #{field.field_value}

                                                else
                                                    span.text-muted
                                                        | Not provided

                                else

                                    p.text-muted.mb-0
                                        | No service-specific information was submitted.


                else

                    .text-center.py-4

                        i.bi.bi-inbox.fs-1.text-muted

                        p.text-muted.mb-0.mt-2
                            | No Investigation Services were recorded for this request.


        //- Payment Summary
        if request.status === 'ACCEPTED'
            -
                const paymentTotal = (request.services || []).reduce(
                    (total, service) =>
                        total + Number(service.investigation_type_service_price || 0),
                    0
                )

            .card.mb-4
                .card-header
                    h5.mb-0 Payment Summary

                .card-body
                    p.text-muted.mb-3
                        | The amount below is calculated from the configured
                        | Investigation Service prices attached to this request.

                    .table-responsive
                        table.table.table-bordered.align-middle.mb-3
                            thead
                                tr
                                    th Investigation Service
                                    th.text-end Service Amount

                            tbody
                                each service in (request.services || [])
                                    tr
                                        td
                                            strong= service.investigation_type_name
                                            if service.investigation_type_code
                                                br
                                                small.text-muted
                                                    | #{service.investigation_type_code}
                                        td.text-end
                                            = new Intl.NumberFormat('en-NG', { style: 'currency', currency: 'NGN' }).format(Number(service.investigation_type_service_price || 0))

                            tfoot
                                tr
                                    th.text-end Total
                                    th.text-end
                                        = new Intl.NumberFormat('en-NG', { style: 'currency', currency: 'NGN' }).format(paymentTotal)

                    if !request.payment

                        .alert.alert-warning.mb-0
                            strong Payment status:
                            |  No payment has been prepared yet.

                            if hasPermission('review_investigation_request')

                                form.mt-3(
                                    method="POST"
                                    action=`/investigation-requests/${request.id}/payment`
                                )

                                    input(
                                        type="hidden"
                                        name="_csrf"
                                        value=csrfToken
                                    )

                                    button.btn.btn-primary(
                                        type="submit"
                                    )
                                        i.bi.bi-credit-card.me-2
                                        | Prepare Payment

                    else if request.payment.status === 'PENDING'

                        .alert.alert-info.mb-0
                            strong Payment status:
                            |  Payment has been prepared and is awaiting
                            | visitor payment action.

                            p.mb-0.mt-2
                                strong Payment Reference:
                                |  #{request.payment.paymentReference}

                    else if request.payment.status === 'INITIATED'

                        .alert.alert-warning.mb-0
                            strong Payment status:
                            |  Visitor has initiated payment.

                            p.mb-0.mt-2
                                strong Payment Reference:
                                |  #{request.payment.paymentReference}

                            if request.payment.amount !== undefined

                                p.mb-0.mt-2
                                    strong Amount:
                                    |  #{new Intl.NumberFormat('en-NG', { style: 'currency', currency: request.payment.currency || 'NGN' }).format(Number(request.payment.amount || 0))}

                            if matchingClient && !request.client_resolution

                                .alert.alert-warning.mt-3.mb-0
                                    strong Client identity resolution required.
                                    |  An existing Client has the same name as the applicant.
                                    |  Resolve the Client identity before confirming payment
                                    |  and activating this request.

                            else if request.client_resolution === 'USE_EXISTING_CLIENT'

                                .alert.alert-success.mt-3.mb-0
                                    strong Client identity resolved.
                                    |  This request has been resolved to use the existing Client
                                    |  #{matchingClient.clientCode}.

                            else if request.client_resolution === 'CREATE_NEW_CLIENT'

                                .alert.alert-success.mt-3.mb-0
                                    strong Client identity resolved.
                                    |  This request has been resolved to create a new Client.

                            if hasPermission('review_investigation_request') && (!matchingClient || request.client_resolution)

                                form.mt-3(
                                    method="POST"
                                    action=`/investigation-requests/${request.id}/payment/confirm`
                                )

                                    input(
                                        type="hidden"
                                        name="_csrf"
                                        value=csrfToken
                                    )

                                    button.btn.btn-success(
                                        type="submit"
                                    )
                                        i.bi.bi-check-circle.me-2
                                        | Confirm Payment

                    else if request.payment.status === 'SUCCESSFUL'

                        .alert.alert-success.mb-0
                            strong Payment status:
                            |  Payment has been completed successfully.

                            p.mb-0.mt-2
                                strong Payment Reference:
                                |  #{request.payment.paymentReference}

                    else if request.payment.status === 'FAILED'

                        .alert.alert-danger.mb-0
                            strong Payment status:
                            |  The previous payment attempt was unsuccessful.

                            p.mb-0.mt-2
                                strong Payment Reference:
                                |  #{request.payment.paymentReference}

                            if hasPermission('review_investigation_request')

                                form.mt-3(
                                    method="POST"
                                    action=`/investigation-requests/${request.id}/payment`
                                )

                                    input(
                                        type="hidden"
                                        name="_csrf"
                                        value=csrfToken
                                    )

                                    button.btn.btn-primary(
                                        type="submit"
                                    )
                                        i.bi.bi-arrow-repeat.me-2
                                        | Prepare New Payment

                    else if request.payment.status === 'CANCELLED'

                        .alert.alert-secondary.mb-0
                            strong Payment status:
                            |  The previous payment attempt was cancelled.

                            p.mb-0.mt-2
                                strong Payment Reference:
                                |  #{request.payment.paymentReference}

                            if hasPermission('review_investigation_request')

                                form.mt-3(
                                    method="POST"
                                    action=`/investigation-requests/${request.id}/payment`
                                )

                                    input(
                                        type="hidden"
                                        name="_csrf"
                                        value=csrfToken
                                    )

                                    button.btn.btn-primary(
                                        type="submit"
                                    )
                                        i.bi.bi-arrow-repeat.me-2
                                        | Prepare New Payment

                    else

                        .alert.alert-secondary.mb-0
                            strong Payment status:
                            |  #{request.payment.status}

                            p.mb-0.mt-2
                                strong Payment Reference:
                                |  #{request.payment.paymentReference}

        //- Client Identity Resolution
        if matchingClient && request.status === 'ACCEPTED' && !request.client_id && !request.case_id && !request.client_resolution

            .card.shadow-sm.border-0.rounded-4.mb-4.border-warning

                .card-header.bg-warning.bg-opacity-10.border-0.pt-4.px-4

                    h5.fw-bold.mb-0.text-warning-emphasis
                        i.bi.bi-exclamation-triangle.me-2
                        | Client Identity Resolution Required

                .card-body.p-4

                    p.mb-3
                        | An existing Client has the same name as the applicant.

                    p.mb-4
                        strong Important:
                        |  a matching name does not establish that this is the same person.
                        |  Staff identity resolution is required before this request can be activated.

                    .row.g-3

                        .col-12.col-md-6

                            small.text-muted.d-block.mb-1
                                | Existing Client

                            .fw-semibold
                                | #{matchingClient.name}

                        .col-12.col-md-6

                            small.text-muted.d-block.mb-1
                                | Client Code

                            .fw-semibold
                                | #{matchingClient.clientCode}

                        .col-12

                            a.btn.btn-outline-primary(
                                href=`/clients/${matchingClient.id}`
                            )

                                i.bi.bi-person-vcard.me-2
                                | View Existing Client


                    .row.g-3.mt-2

                        .col-12.col-md-6

                            form(
                                method="POST"
                                action=`/investigation-requests/${request.id}/resolve-client`
                            )

                                input(
                                    type="hidden"
                                    name="_csrf"
                                    value=csrfToken
                                )

                                input(
                                    type="hidden"
                                    name="resolution"
                                    value="USE_EXISTING_CLIENT"
                                )

                                input(
                                    type="hidden"
                                    name="client_id"
                                    value=matchingClient.id
                                )

                                button.btn.btn-success.w-100(
                                    type="submit"
                                )

                                    i.bi.bi-person-check.me-2
                                    | Use Existing Client


                        .col-12.col-md-6

                            form(
                                method="POST"
                                action=`/investigation-requests/${request.id}/resolve-client`
                            )

                                input(
                                    type="hidden"
                                    name="_csrf"
                                    value=csrfToken
                                )

                                input(
                                    type="hidden"
                                    name="resolution"
                                    value="CREATE_NEW_CLIENT"
                                )

                                button.btn.btn-outline-primary.w-100(
                                    type="submit"
                                )

                                    i.bi.bi-person-plus.me-2
                                    | Create New Client


        //- Review Information
        if request.status !== 'PENDING' || request.reviewed_by || request.reviewed_at || request.rejection_reason

            .card.shadow-sm.border-0.rounded-4.mb-4

                .card-header.bg-white.border-0.pt-4.px-4

                    h5.fw-bold.mb-0
                        i.bi.bi-clipboard-check.me-2.text-primary
                        | Review Information

                .card-body.p-4

                    .row.g-4

                        if request.reviewed_by

                            .col-12.col-md-6

                                small.text-muted.d-block.mb-1
                                    | Reviewed By

                                .fw-semibold
                                    | User ID #{request.reviewed_by}


                        if request.reviewed_at

                            .col-12.col-md-6

                                small.text-muted.d-block.mb-1
                                    | Reviewed At

                                .fw-semibold
                                    = new Date(request.reviewed_at).toLocaleString()


                        if request.rejection_reason

                            .col-12

                                small.text-muted.d-block.mb-2
                                    | Rejection Reason

                                .p-3.bg-light.rounded
                                    | #{request.rejection_reason}


        //- Current System Linkage
        if request.client_id || request.case_id

            .card.shadow-sm.border-0.rounded-4.mb-4

                .card-header.bg-white.border-0.pt-4.px-4

                    h5.fw-bold.mb-0
                        i.bi.bi-link-45deg.me-2.text-primary
                        | Current System Linkage

                .card-body.p-4

                    .row.g-4

                        if request.client_id

                            .col-12.col-md-6

                                small.text-muted.d-block.mb-1
                                    | Client ID

                                .fw-semibold
                                    | #{request.client_id}


                        if request.case_id

                            .col-12.col-md-6

                                small.text-muted.d-block.mb-1
                                    | Case ID

                                .fw-semibold
                                    | #{request.case_id}

        //- Reject Investigation Request Modal
        .modal.fade(
            id="rejectInvestigationRequestModal"
            tabindex="-1"
            aria-labelledby="rejectInvestigationRequestModalLabel"
            aria-hidden="true"
        )

            .modal-dialog

                .modal-content

                    .modal-header

                        h5.modal-title(
                            id="rejectInvestigationRequestModalLabel"
                        )
                            | Reject Investigation Request

                        button.btn-close(
                            type="button"
                            data-bs-dismiss="modal"
                            aria-label="Close"
                        )


                    form(
                        action=`/investigation-requests/${request.id}/reject`
                        method="POST"
                    )

                        input(
                            type="hidden"
                            name="_csrf"
                            value=csrfToken
                        )


                        .modal-body

                            p.text-muted
                                | Please provide the reason for rejecting
                                | this Investigation Request.


                            .mb-3

                                label.form-label(
                                    for="rejectionReason"
                                )
                                    | Rejection Reason

                                textarea.form-control(
                                    id="rejectionReason"
                                    name="rejection_reason"
                                    rows="5"
                                    maxlength="2000"
                                    required
                                )


                        .modal-footer

                            button.btn.btn-secondary(
                                type="button"
                                data-bs-dismiss="modal"
                            )
                                | Cancel


                            button.btn.btn-danger(
                                type="submit"
                                onclick="return confirm('Are you sure you want to reject this Investigation Request?');"
                            )
                                i.bi.bi-x-circle.me-2
                                | Confirm Rejection
