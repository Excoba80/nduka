extends ../layouts/main

block content

    .container-fluid

        //- Page Header
        .d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-center.mb-4

            div
                h1.h3.fw-bold.mb-1
                    | Change Password

                p.text-muted.mb-0
                    | Update your account password.

        .row

            .col-12.col-lg-7.col-xl-6

                .card.shadow-sm.border-0.rounded-4

                    .card-body.p-4

                        if error
                            .alert.alert-danger.d-flex.align-items-center(
                                role='alert'
                            )
                                i.bi.bi-exclamation-triangle-fill.me-2
                                div
                                    | #{error}

                        form(
                            action='/change-password'
                            method='POST'
                        )

                            input(
                                type='hidden'
                                name='_csrf'
                                value=csrfToken
                            )

                            .mb-3

                                label.form-label.fw-semibold(
                                    for='current_password'
                                )
                                    | Current Password

                                input.form-control(
                                    type='password'
                                    id='current_password'
                                    name='current_password'
                                    autocomplete='current-password'
                                    required
                                )

                            .mb-3

                                label.form-label.fw-semibold(
                                    for='new_password'
                                )
                                    | New Password

                                input.form-control(
                                    type='password'
                                    id='new_password'
                                    name='new_password'
                                    minlength='8'
                                    autocomplete='new-password'
                                    required
                                )

                                .form-text
                                    | Password must be at least 8 characters long.

                            .mb-4

                                label.form-label.fw-semibold(
                                    for='confirm_password'
                                )
                                    | Confirm New Password

                                input.form-control(
                                    type='password'
                                    id='confirm_password'
                                    name='confirm_password'
                                    minlength='8'
                                    autocomplete='new-password'
                                    required
                                )

                            .d-flex.flex-wrap.gap-2

                                button.btn.btn-primary(
                                    type='submit'
                                )
                                    i.bi.bi-shield-lock.me-2
                                    | Change Password

                                a.btn.btn-outline-secondary(
                                    href='/dashboard'
                                )
                                    | Cancel