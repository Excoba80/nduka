extends ../layouts/main

block content

    .container-fluid

        //- Page Header
        .d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-center.mb-4

            div
                h1.h3.fw-bold.mb-1
                    | User Details

                p.text-muted.mb-0
                    | View account information and access details.

            .mt-3.mt-md-0.d-flex.flex-wrap.gap-2

                a.btn.btn-outline-secondary(
                    href="/users"
                )
                    i.bi.bi-arrow-left.me-2
                    | Back to Users

                if user.status === 'active'

                    a.btn.btn-primary(
                        href='/users/' + user.id + '/edit'
                    )
                        i.bi.bi-pencil-square.me-2
                        | Edit User

                    form(
                        action='/users/' + user.id + '/suspend'
                        method='POST'
                        onsubmit="return confirm('Are you sure you want to suspend this user?');"
                    )

                        input(
                            type='hidden'
                            name='_csrf'
                            value=csrfToken
                        )

                        button.btn.btn-outline-danger(
                            type='submit'
                        )
                            i.bi.bi-person-slash.me-2
                            | Suspend User

                else if user.status === 'suspended'

                    a.btn.btn-primary(
                        href='/users/' + user.id + '/edit'
                    )
                        i.bi.bi-pencil-square.me-2
                        | Edit User

                    form(
                        action='/users/' + user.id + '/reactivate'
                        method='POST'
                        onsubmit="return confirm('Are you sure you want to reactivate this user?');"
                    )

                        input(
                            type='hidden'
                            name='_csrf'
                            value=csrfToken
                        )

                        button.btn.btn-outline-success(
                            type='submit'
                        )
                            i.bi.bi-person-check.me-2
                            | Reactivate User

                //- Reset Password
                button.btn.btn-outline-warning(
                    type='button'
                    data-bs-toggle='modal'
                    data-bs-target='#resetPasswordModal'
                )
                    i.bi.bi-key.me-2
                    | Reset Password


        //- User Information
        .row.g-4

            //- Basic Information
            .col-12.col-lg-8

                .card.shadow-sm.border-0.rounded-4

                    .card-body.p-4

                        .d-flex.align-items-center.mb-4

                            .bg-primary.bg-opacity-10.rounded-circle.p-3.me-3
                                i.bi.bi-person-circle.fs-2.text-primary

                            div
                                h4.fw-bold.mb-1
                                    | #{user.first_name} #{user.last_name}

                                p.text-muted.mb-0
                                    | @#{user.username}

                        hr

                        .row.g-4

                            .col-12.col-md-6

                                small.text-muted.d-block
                                    | First Name

                                .fw-semibold
                                    | #{user.first_name}

                            .col-12.col-md-6

                                small.text-muted.d-block
                                    | Last Name

                                .fw-semibold
                                    | #{user.last_name}

                            .col-12.col-md-6

                                small.text-muted.d-block
                                    | Username

                                .fw-semibold
                                    | #{user.username}

                            .col-12.col-md-6

                                small.text-muted.d-block
                                    | Email

                                .fw-semibold
                                    | #{user.email}

                            .col-12.col-md-6

                                small.text-muted.d-block
                                    | Phone

                                .fw-semibold
                                    | #{user.phone || 'Not provided'}


            //- Account Status / Roles
            .col-12.col-lg-4

                .card.shadow-sm.border-0.rounded-4.mb-4

                    .card-body.p-4

                        h5.fw-bold.mb-3
                            | Account Status

                        if user.status === 'active'

                            span.badge.text-bg-success.fs-6
                                | Active

                        else if user.status === 'suspended'

                            span.badge.text-bg-warning.fs-6
                                | Suspended

                        else if user.status === 'disabled'

                            span.badge.text-bg-danger.fs-6
                                | Disabled

                        else

                            span.badge.text-bg-secondary.fs-6
                                | #{user.status}


                .card.shadow-sm.border-0.rounded-4

                    .card-body.p-4

                        h5.fw-bold.mb-3
                            | Roles

                        if user.roles

                            each role in user.roles.split(', ')

                                span.badge.text-bg-secondary.me-1.mb-1
                                    | #{role}

                        else

                            p.text-muted.mb-0
                                | No role assigned.


        //- Account Metadata
        .card.shadow-sm.border-0.rounded-4.mt-4

            .card-body.p-4

                h5.fw-bold.mb-3
                    | Account Information

                .row.g-4

                    .col-12.col-md-6

                        small.text-muted.d-block
                            | User ID

                        .fw-semibold
                            | #{user.id}

                    .col-12.col-md-6

                        small.text-muted.d-block
                            | Created

                        .fw-semibold
                            | #{user.created_at}

                    .col-12.col-md-6

                        small.text-muted.d-block
                            | Last Updated

                        .fw-semibold
                            | #{user.updated_at}


        //- Reset Password Modal
        .modal.fade(
            id='resetPasswordModal'
            tabindex='-1'
            aria-labelledby='resetPasswordModalLabel'
            aria-hidden='true'
        )

            .modal-dialog

                .modal-content

                    .modal-header

                        h5.modal-title(
                            id='resetPasswordModalLabel'
                        )
                            | Reset User Password

                        button.btn-close(
                            type='button'
                            data-bs-dismiss='modal'
                            aria-label='Close'
                        )

                    form(
                        action='/users/' + user.id + '/reset-password'
                        method='POST'
                    )

                        input(
                            type='hidden'
                            name='_csrf'
                            value=csrfToken
                        )

                        .modal-body

                            p.text-muted
                                | Set a new password for #{user.username}.

                            .mb-3

                                label.form-label(
                                    for='resetPassword'
                                )
                                    | New Password

                                input.form-control(
                                    type='password'
                                    id='resetPassword'
                                    name='password'
                                    required
                                    minlength='8'
                                    autocomplete='new-password'
                                )

                            .mb-3

                                label.form-label(
                                    for='confirmResetPassword'
                                )
                                    | Confirm New Password

                                input.form-control(
                                    type='password'
                                    id='confirmResetPassword'
                                    name='confirm_password'
                                    required
                                    minlength='8'
                                    autocomplete='new-password'
                                )

                        .modal-footer

                            button.btn.btn-secondary(
                                type='button'
                                data-bs-dismiss='modal'
                            )
                                | Cancel

                            button.btn.btn-warning(
                                type='submit'
                                onclick="return confirm('Are you sure you want to reset this user\\'s password?');"
                            )
                                i.bi.bi-key.me-2
                                | Reset Password