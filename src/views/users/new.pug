extends ../layouts/main

block content

    .container-fluid

        .d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-center.mb-4

            div
                h1.h3.fw-bold.mb-1
                    | Add User

                p.text-muted.mb-0
                    | Create a new NDUKA system user.

            .mt-3.mt-md-0

                a.btn.btn-outline-secondary(href="/users")
                    i.bi.bi-arrow-left.me-2
                    | Back to Users


        .row.justify-content-center

            .col-12.col-xl-9

                .card.shadow-sm.border-0.rounded-4

                    .card-body.p-4.p-md-5

                        if error
                            .alert.alert-danger(role="alert")
                                i.bi.bi-exclamation-triangle-fill.me-2
                                | #{error}


                        form(
                            action="/users"
                            method="POST"
                            novalidate
                        )

                            input(
                                type="hidden"
                                name="_csrf"
                                value=csrfToken
                            )

                            h5.fw-bold.mb-4
                                | Personal Information

                            .row.g-3

                                .col-12.col-md-6

                                    label.form-label(for="first_name")
                                        | First Name

                                    input.form-control(
                                        id="first_name"
                                        name="first_name"
                                        type="text"
                                        value=formData.first_name || ''
                                        required
                                        autocomplete="given-name"
                                    )

                                .col-12.col-md-6

                                    label.form-label(for="last_name")
                                        | Last Name

                                    input.form-control(
                                        id="last_name"
                                        name="last_name"
                                        type="text"
                                        value=formData.last_name || ''
                                        required
                                        autocomplete="family-name"
                                    )

                                .col-12.col-md-6

                                    label.form-label(for="email")
                                        | Email

                                    input.form-control(
                                        id="email"
                                        name="email"
                                        type="email"
                                        value=formData.email || ''
                                        required
                                        autocomplete="email"
                                    )

                                .col-12.col-md-6

                                    label.form-label(for="phone")
                                        | Phone

                                    input.form-control(
                                        id="phone"
                                        name="phone"
                                        type="text"
                                        value=formData.phone || ''
                                        required
                                        autocomplete="tel"
                                    )


                            hr.my-4


                            h5.fw-bold.mb-4
                                | Account Information

                            .row.g-3

                                .col-12.col-md-6

                                    label.form-label(for="username")
                                        | Username

                                    input.form-control(
                                        id="username"
                                        name="username"
                                        type="text"
                                        value=formData.username || ''
                                        required
                                        autocomplete="username"
                                    )

                                .col-12.col-md-6

                                    label.form-label(for="role_id")
                                        | Role

                                    select.form-select(
                                        id="role_id"
                                        name="role_id"
                                        required
                                    )

                                        option(
                                            value=""
                                            selected=!formData.role_id
                                            disabled
                                        )
                                            | Select a role

                                        each role in roles

                                            option(
                                                value=role.id
                                                selected=String(formData.role_id) === String(role.id)
                                            )
                                                | #{role.name}


                                .col-12.col-md-6

                                    label.form-label(for="password")
                                        | Password

                                    input.form-control(
                                        id="password"
                                        name="password"
                                        type="password"
                                        required
                                        autocomplete="new-password"
                                    )

                                .col-12.col-md-6

                                    label.form-label(for="confirm_password")
                                        | Confirm Password

                                    input.form-control(
                                        id="confirm_password"
                                        name="confirm_password"
                                        type="password"
                                        required
                                        autocomplete="new-password"
                                    )


                            .d-flex.justify-content-end.gap-2.mt-4

                                a.btn.btn-outline-secondary(
                                    href="/users"
                                )
                                    | Cancel

                                button.btn.btn-primary(
                                    type="submit"
                                )
                                    i.bi.bi-person-plus.me-2
                                    | Create User