nav.navbar.navbar-expand-lg.navbar-dark.bg-primary.shadow-sm

    .container-fluid

        a.navbar-brand(href="/")
            i.bi.bi-shield-check.me-2
            | NDUKA

        button.navbar-toggler(
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#mainNavbar"
            aria-controls="mainNavbar"
            aria-expanded="false"
            aria-label="Toggle navigation"
        )
            span.navbar-toggler-icon

        .collapse.navbar-collapse#mainNavbar

            //- Left Menu
            ul.navbar-nav.me-auto.mb-2.mb-lg-0

                if sessionUser

                    //- Dashboard
                    li.nav-item
                        a.nav-link(
                            href="/dashboard"
                            class=currentPath === '/dashboard' ? 'active' : ''
                            aria-current=currentPath === '/dashboard' ? 'page' : undefined
                        )
                            i.bi.bi-speedometer2.me-1
                            | Dashboard

                    //- Users
                    if hasPermission('view_user')
                        li.nav-item
                            a.nav-link(
                                href="/users"
                                class=currentPath === '/users' ? 'active' : ''
                                aria-current=currentPath === '/users' ? 'page' : undefined
                            )
                                i.bi.bi-people.me-1
                                | Users

                    //- My Investigations
                    if isClientUser
                        li.nav-item
                            a.nav-link(
                                href="/my-investigations"
                                class=currentPath.startsWith('/my-investigations') ? 'active' : ''
                                aria-current=currentPath.startsWith('/my-investigations') ? 'page' : undefined
                            )
                                i.bi.bi-search.me-1
                                | My Investigations

                    //- Cases
                    if hasPermission('view_case')
                        li.nav-item
                            a.nav-link(
                                href="/cases"
                                class=currentPath === '/cases' ? 'active' : ''
                                aria-current=currentPath === '/cases' ? 'page' : undefined
                            )
                                i.bi.bi-folder2-open.me-1
                                | Cases

                    //- Clients
                    if hasPermission('view_client')
                        li.nav-item
                            a.nav-link(
                                href="/clients"
                                class=currentPath === '/clients' ? 'active' : ''
                                aria-current=currentPath === '/clients' ? 'page' : undefined
                            )
                                i.bi.bi-people.me-1
                                | Clients

                    //- Investigations
                    if hasPermission('view_case')
                        li.nav-item
                            a.nav-link(
                                href="/investigations"
                                class=currentPath === '/investigations' ? 'active' : ''
                                aria-current=currentPath === '/investigations' ? 'page' : undefined
                            )
                                i.bi.bi-search.me-1
                                | Investigations

                    //- Audit Logs
                    if hasPermission('view_audit_log')
                        li.nav-item
                            a.nav-link(
                                href="/audit"
                                class=currentPath.startsWith('/audit') ? 'active' : ''
                                aria-current=currentPath.startsWith('/audit') ? 'page' : undefined
                            )
                                i.bi.bi-journal-text.me-1
                                | Audit Logs

            //- Right Menu
            ul.navbar-nav.ms-auto

                if sessionUser

                    li.nav-item.dropdown

                        a.nav-link.dropdown-toggle(
                            href="#"
                            role="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                        )
                            i.bi.bi-person-circle.me-1
                            | #{sessionUser.username}

                        ul.dropdown-menu.dropdown-menu-end

                            li
                                a.dropdown-item(href="/profile")
                                    i.bi.bi-person.me-2
                                    | My Profile

                            li
                                a.dropdown-item(href="/change-password")
                                    i.bi.bi-shield-lock.me-2
                                    | Change Password

                            li
                                hr.dropdown-divider

                            li
                                form(
                                    action="/logout"
                                    method="POST"
                                )

                                    input(
                                        type="hidden"
                                        name="_csrf"
                                        value=csrfToken
                                    )

                                    button.dropdown-item(
                                        type="submit"
                                    )
                                        i.bi.bi-box-arrow-right.me-2
                                        | Logout

                else

                    li.nav-item
                        a.nav-link(
                            href="/login"
                            class=currentPath === '/login' ? 'active' : ''
                            aria-current=currentPath === '/login' ? 'page' : undefined
                        )
                            i.bi.bi-box-arrow-in-right.me-1
                            | Sign In
