//- ======================================================
//- Global Flash Messages
//- ======================================================

if success
    if typeof success === 'string'

        .container.mt-3

            .alert.alert-success.alert-dismissible.fade.show(
                role="alert"
            )

                i.bi.bi-check-circle-fill.me-2
                | #{success}

                button.btn-close(
                    type="button"
                    data-bs-dismiss="alert"
                    aria-label="Close"
                )


