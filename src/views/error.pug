extends layouts/main

block content
    .container.mt-5
        .row.justify-content-center
            .col-lg-8
                .card.shadow
                    .card-header.bg-danger.text-white
                        h3.mb-0 Error

                    .card-body
                        h4= message

                        if error && error.status
                            p
                                strong Status:
                                |  #{error.status}

                        if error && error.stack
                            pre.mt-3= error.stack