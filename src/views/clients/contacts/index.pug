extends ../../layouts/main

block content

    .container-fluid

        //- Page Header
        .d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-center.mb-4

            div

                h1.h3.fw-bold.mb-1
                    | Client Contacts

                p.text-muted.mb-0
                    | Manage contacts associated with this client.

            .mt-3.mt-md-0

                .d-flex.gap-2

                    a.btn.btn-outline-secondary(
                        href=`/clients/${clientId}`
                    )
                        i.bi.bi-arrow-left.me-2
                        | Back to Client

                    if sessionUser && sessionUser.permissions && sessionUser.permissions.includes('create_client_contact')
                        a.btn.btn-primary(
                            href=`/clients/${clientId}/contacts/new`
                        )
                            i.bi.bi-person-plus.me-2
                            | Add Contact


        //- Contacts Table Card
        .card.shadow-sm.border-0.rounded-4

            .card-body.p-0

                .table-responsive

                    table.table.table-hover.align-middle.mb-0

                        thead.table-light

                            tr

                                th.ps-4(scope="col")
                                    | #

                                th(scope="col")
                                    | Contact

                                th(scope="col")
                                    | Position

                                th(scope="col")
                                    | Contact Details

                                th(scope="col")
                                    | Status

                                th(scope="col")
                                    | Primary

                                th.pe-4.text-end(scope="col")
                                    | Actions


                        tbody

                            if contacts && contacts.length

                                each contact, index in contacts

                                    tr

                                        td.ps-4
                                            | #{index + 1}


                                        td

                                            .fw-semibold

                                                if contact.title
                                                    | #{contact.title}
                                                    |&nbsp;

                                                | #{contact.first_name}

                                                if contact.middle_name
                                                    |&nbsp;#{contact.middle_name}

                                                |&nbsp;#{contact.last_name}

                                            if contact.email
                                                small.text-muted
                                                    | #{contact.email}


                                        td

                                            if contact.position
                                                | #{contact.position}
                                            else
                                                span.text-muted
                                                    | Not specified


                                        td

                                            div
                                                i.bi.bi-telephone.me-1
                                                | #{contact.phone}

                                            if contact.email

                                                small.text-muted.d-block

                                                    i.bi.bi-envelope.me-1
                                                    | #{contact.email}


                                        td

                                            if contact.is_active
                                                span.badge.text-bg-success
                                                    | Active
                                            else
                                                span.badge.text-bg-secondary
                                                    | Inactive


                                        td

                                            if contact.is_primary
                                                span.badge.text-bg-primary
                                                    i.bi.bi-star-fill.me-1
                                                    | Primary
                                            else
                                                span.text-muted
                                                    | —


                                        td.pe-4.text-end

                                            .d-flex.justify-content-end.gap-1

                                                if sessionUser && sessionUser.permissions && sessionUser.permissions.includes('update_client_contact')

                                                    a.btn.btn-sm.btn-outline-primary(
                                                        href=`/clients/${clientId}/contacts/${contact.id}/edit`
                                                        title="Edit contact"
                                                    )
                                                        i.bi.bi-pencil


                                                    if !contact.is_primary && contact.is_active

                                                        form(
                                                            method="POST"
                                                            action=`/clients/${clientId}/contacts/${contact.id}/primary`
                                                            class="d-inline"
                                                        )

                                                            input(
                                                                type="hidden"
                                                                name="_csrf"
                                                                value=csrfToken
                                                            )

                                                            button.btn.btn-sm.btn-outline-warning(
                                                                type="submit"
                                                                title="Set as primary"
                                                            )
                                                                i.bi.bi-star


                                                    form(
                                                        method="POST"
                                                        action=`/clients/${clientId}/contacts/${contact.id}/status`
                                                        class="d-inline"
                                                    )

                                                        input(
                                                            type="hidden"
                                                            name="_csrf"
                                                            value=csrfToken
                                                        )

                                                        if contact.is_active

                                                            input(
                                                                type="hidden"
                                                                name="is_active"
                                                                value="0"
                                                            )

                                                            button.btn.btn-sm.btn-outline-danger(
                                                                type="submit"
                                                                title="Deactivate contact"
                                                            )
                                                                i.bi.bi-person-dash

                                                        else

                                                            input(
                                                                type="hidden"
                                                                name="is_active"
                                                                value="1"
                                                            )

                                                            button.btn.btn-sm.btn-outline-success(
                                                                type="submit"
                                                                title="Activate contact"
                                                            )
                                                                i.bi.bi-person-check


                            else

                                tr

                                    td.text-center.py-5(
                                        colspan="7"
                                    )

                                        i.bi.bi-person-lines-fill.display-5.text-muted

                                        h5.mt-3.mb-1
                                            | No Contacts Found

                                        p.text-muted.mb-0
                                            | This client currently has no contacts.
