extends ../../layouts/main

block content

    .container-fluid

        //- Page Header
        .d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-center.mb-4

            div
                h1.h3.mb-1
                    i.bi.bi-journal-text.me-2
                    | Case Notes

                p.text-muted.mb-0
                    | #{caseRecord.case_reference} — #{caseRecord.case_title}

            div.mt-3.mt-md-0.d-flex.flex-wrap.gap-2

                a.btn.btn-outline-secondary(
                    href=`/cases/${caseRecord.id}`
                )
                    i.bi.bi-arrow-left.me-2
                    | Back to Case

                if hasPermission('create_case_note') && !caseRecord.status_is_terminal
                    a.btn.btn-primary(
                        href=`/cases/${caseRecord.id}/notes/new`
                    )
                        i.bi.bi-plus-circle.me-2
                        | Add Case Note


        //- Case Information
        .card.shadow-sm.mb-4

            .card-header.bg-white.py-3

                .d-flex.justify-content-between.align-items-center

                    h5.mb-0
                        i.bi.bi-folder2-open.me-2
                        | Case Information

                    if caseRecord.status_is_terminal
                        span.badge.bg-secondary
                            | #{caseRecord.status_name}
                    else
                        span.badge.bg-primary
                            | #{caseRecord.status_name}

            .card-body

                .row.g-3

                    .col-12.col-md-4

                        .text-muted.small.mb-1
                            | Case Reference

                        .fw-semibold
                            | #{caseRecord.case_reference}

                    .col-12.col-md-4

                        .text-muted.small.mb-1
                            | Client

                        .fw-semibold
                            | #{caseRecord.client_name}

                        if caseRecord.client_code
                            .small.text-muted
                                | #{caseRecord.client_code}

                    .col-12.col-md-4

                        .text-muted.small.mb-1
                            | Case Status

                        .fw-semibold
                            | #{caseRecord.status_name}


        //- Notes
        .card.shadow-sm

            .card-header.bg-white.py-3

                .d-flex.justify-content-between.align-items-center

                    h5.mb-0
                        i.bi.bi-journal-text.me-2
                        | Notes

                    span.badge.bg-primary
                        | #{notes ? notes.length : 0}

            .card-body

                if notes && notes.length > 0

                    each note in notes

                        .border.rounded.p-3.mb-3

                            .d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-start.gap-3

                                div

                                    .d-flex.flex-wrap.align-items-center.gap-2

                                        if note.note_title
                                            h6.fw-semibold.mb-0
                                                | #{note.note_title}
                                        else
                                            h6.fw-semibold.mb-0
                                                | Case Note

                                        if note.is_private
                                            span.badge.bg-warning.text-dark
                                                i.bi.bi-lock-fill.me-1
                                                | Private
                                        else
                                            span.badge.bg-success
                                                i.bi.bi-eye.me-1
                                                | Standard

                                    .small.text-muted.mt-2

                                        if note.created_by_first_name || note.created_by_last_name
                                            | #{note.created_by_first_name || ''} #{note.created_by_middle_name || ''} #{note.created_by_last_name || ''}
                                        else
                                            | @#{note.created_by_username}

                                        if note.created_by_username
                                            |  · @#{note.created_by_username}

                                        |  · #{note.created_at}

                                if hasPermission('update_case_note') && !caseRecord.status_is_terminal

                                    a.btn.btn-sm.btn-outline-primary(
                                        href=`/cases/${caseRecord.id}/notes/${note.id}/edit`
                                    )
                                        i.bi.bi-pencil.me-1
                                        | Edit


                            if note.investigation_type_name

                                .small.mt-3

                                    span.text-muted
                                        | Investigation Service:

                                    span.fw-semibold.ms-1
                                        | #{note.investigation_type_name}

                                    if note.investigation_type_code
                                        span.text-muted.ms-1
                                            | (#{note.investigation_type_code})


                            .mt-3

                                .bg-light.rounded.p-3
                                    | #{note.note_content}

                            if note.updated_at && note.updated_at != note.created_at

                                .small.text-muted.mt-2
                                    i.bi.bi-clock-history.me-1
                                    | Updated #{note.updated_at}

                else

                    .text-center.py-5

                        i.bi.bi-journal-x.fs-1.text-muted

                        h5.mt-3
                            | No Case Notes

                        p.text-muted.mb-3
                            | No notes have been recorded for this Case yet.

                        if hasPermission('create_case_note') && !caseRecord.status_is_terminal

                            a.btn.btn-primary(
                                href=`/cases/${caseRecord.id}/notes/new`
                            )
                                i.bi.bi-plus-circle.me-2
                                | Add First Case Note
