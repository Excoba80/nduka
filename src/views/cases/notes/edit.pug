extends ../../layouts/main

block content

    .container-fluid

        .d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-center.mb-4

            div

                h1.h3.mb-1
                    i.bi.bi-journal-text.me-2
                    | Edit Case Note

                p.text-muted.mb-0
                    | #{caseRecord.case_reference} — #{caseRecord.case_title}

            div.mt-3.mt-md-0

                a.btn.btn-outline-secondary(
                    href=`/cases/${caseRecord.id}/notes`
                )
                    i.bi.bi-arrow-left.me-2
                    | Back to Case Notes


        .row.justify-content-center

            .col-12.col-xl-8

                .card.shadow-sm

                    .card-header.bg-white.py-3

                        h5.mb-0
                            i.bi.bi-pencil-square.me-2
                            | Edit Note

                    .card-body

                        if error

                            .alert.alert-danger

                                i.bi.bi-exclamation-triangle.me-2
                                | #{error}


                        form(
                            method="POST"
                            action=`/cases/${caseRecord.id}/notes/${note.id}`
                        )

                            input(
                                type="hidden"
                                name="_csrf"
                                value=csrfToken
                            )


                            .mb-3

                                label.form-label.fw-semibold(
                                    for="case_investigation_service_id"
                                )
                                    | Investigation Service

                                select.form-select(
                                    id="case_investigation_service_id"
                                    name="case_investigation_service_id"
                                )

                                    option(
                                        value=""
                                        selected=!note.case_investigation_service_id
                                    )
                                        | General Case Note

                                    if investigationServices && investigationServices.length > 0

                                        each service in investigationServices

                                            option(
                                                value=service.id
                                                selected=Number(note.case_investigation_service_id) === Number(service.id)
                                            )
                                                | #{service.investigation_type_name} — #{service.service_status_name}

                                .form-text
                                    | Select the investigation service this note relates to, or leave it as a General Case Note.


                            .mb-3

                                label.form-label.fw-semibold(
                                    for="note_title"
                                )
                                    | Note Title

                                input.form-control(
                                    type="text"
                                    id="note_title"
                                    name="note_title"
                                    maxlength="200"
                                    value=note.note_title || ''
                                    placeholder="Optional note title"
                                )

                                .form-text
                                    | Maximum 200 characters.


                            .mb-3

                                label.form-label.fw-semibold(
                                    for="note_content"
                                )
                                    | Note Content

                                textarea.form-control(
                                    id="note_content"
                                    name="note_content"
                                    rows="10"
                                    required
                                    placeholder="Enter the Case Note..."
                                )= note.note_content || ''


                            .form-check.mb-4

                                input.form-check-input(
                                    type="checkbox"
                                    id="is_private"
                                    name="is_private"
                                    value="1"
                                    checked=Boolean(note.is_private)
                                )

                                label.form-check-label.fw-semibold(
                                    for="is_private"
                                )
                                    i.bi.bi-lock-fill.me-1
                                    | Private Note

                                .form-text
                                    | Private notes are internal investigation records.


                            .d-flex.flex-column.flex-sm-row.justify-content-between.gap-2

                                a.btn.btn-outline-secondary(
                                    href=`/cases/${caseRecord.id}/notes`
                                )
                                    | Cancel

                                button.btn.btn-primary(
                                    type="submit"
                                )
                                    i.bi.bi-save.me-2
                                    | Update Note
