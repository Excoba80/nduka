extends ../layouts/main

block content

    .container-fluid

        //- Page Header
        .d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-center.mb-4

            div
                h1.h3.mb-1
                    i.bi.bi-folder2-open.me-2
                    | Case Management

                p.text-muted.mb-0
                    | View and manage investigation cases.

            if hasPermission('create_case')
                div.mt-3.mt-md-0
                    a.btn.btn-primary(href="/cases/new")
                        i.bi.bi-plus-circle.me-2
                        | New Case


        //- Case List
        .card.shadow-sm

            .card-header.bg-white.py-3

                .d-flex.justify-content-between.align-items-center

                    h5.mb-0
                        i.bi.bi-folder.me-2
                        | Cases

                    if cases && cases.length
                        span.badge.bg-secondary
                            | #{cases.length} #{cases.length === 1 ? 'Case' : 'Cases'}

            .card-body.p-0

                if cases && cases.length

                    .table-responsive

                        table.table.table-hover.align-middle.mb-0

                            thead.table-light

                                tr
                                    th Case Reference
                                    th Client
                                    th Case Title
                                    th Status
                                    th Priority
                                    th Investigator
                                    th Opened
                                    th.text-end Actions

                            tbody

                                each caseItem in cases

                                    tr

                                        td
                                            a.fw-semibold(
                                                href=`/cases/${caseItem.id}`
                                            )
                                                | #{caseItem.case_reference}

                                        td
                                            if caseItem.client_name
                                                | #{caseItem.client_name}
                                            else
                                                span.text-muted
                                                    | —

                                        td
                                            if caseItem.case_title
                                                | #{caseItem.case_title}
                                            else
                                                span.text-muted
                                                    | —

                                        td

                                            if caseItem.status_name

                                                if caseItem.status_is_terminal
                                                    span.badge.bg-secondary
                                                        | #{caseItem.status_name}
                                                else
                                                    span.badge.bg-primary
                                                        | #{caseItem.status_name}

                                            else
                                                span.text-muted
                                                    | —

                                        td

                                            if caseItem.priority_name
                                                span.badge.bg-light.text-dark.border
                                                    | #{caseItem.priority_name}
                                            else
                                                span.text-muted
                                                    | —

                                        td

                                            if caseItem.assigned_to_first_name || caseItem.assigned_to_last_name

                                                | #{caseItem.assigned_to_first_name || ''} #{caseItem.assigned_to_last_name || ''}

                                                if caseItem.assigned_to_username
                                                    br
                                                    small.text-muted
                                                        | @#{caseItem.assigned_to_username}

                                            else
                                                span.text-muted
                                                    | Unassigned

                                        td

                                            if caseItem.opened_at

                                                | #{new Date(caseItem.opened_at).toLocaleDateString('en-NG')}

                                            else
                                                span.text-muted
                                                    | —

                                        td.text-end

                                            a.btn.btn-sm.btn-outline-primary(
                                                href=`/cases/${caseItem.id}`
                                                title="View Case"
                                            )
                                                i.bi.bi-eye.me-1
                                                | View

                else

                    .text-center.py-5.px-3

                        i.bi.bi-folder2-open.fs-1.text-muted

                        h5.mt-3
                            | No Cases Found

                        p.text-muted.mb-4
                            | There are currently no cases available to you.

                        if hasPermission('create_case')
                            a.btn.btn-primary(
                                href="/cases/new"
                            )
                                i.bi.bi-plus-circle.me-2
                                | Create First Case
