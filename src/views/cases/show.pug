extends ../layouts/main

block content

    .container-fluid

        //- Page Header
        .d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-center.mb-4

            div
                h1.h3.mb-1
                    i.bi.bi-folder2-open.me-2
                    | Case Details

                p.text-muted.mb-0
                    | #{caseRecord.case_reference}

            div.mt-3.mt-md-0.d-flex.flex-wrap.gap-2

                a.btn.btn-outline-secondary(
                    href="/cases"
                )
                    i.bi.bi-arrow-left.me-2
                    | Back to Cases

                if hasPermission('update_case') && !caseRecord.status_is_terminal
                    a.btn.btn-outline-primary(
                        href=`/cases/${caseRecord.id}/edit`
                    )
                        i.bi.bi-pencil.me-2
                        | Edit Case


        //- Case Summary
        .row.g-4

            //- Main Information
            .col-12.col-xl-8

                .card.shadow-sm.mb-4

                    .card-header.bg-white.py-3

                        .d-flex.justify-content-between.align-items-center

                            h5.mb-0
                                i.bi.bi-info-circle.me-2
                                | Case Information

                            if caseRecord.status_name

                                if caseRecord.status_is_terminal
                                    span.badge.bg-secondary
                                        | #{caseRecord.status_name}
                                else
                                    span.badge.bg-primary
                                        | #{caseRecord.status_name}

                    .card-body

                        .row.g-4

                            .col-md-6

                                .text-muted.small.mb-1
                                    | Case Reference

                                .fw-semibold
                                    | #{caseRecord.case_reference}


                            .col-md-6

                                .text-muted.small.mb-1
                                    | Client

                                .fw-semibold
                                    | #{caseRecord.client_name}

                                if caseRecord.client_code
                                    .small.text-muted
                                        | #{caseRecord.client_code}


                            .col-12

                                .text-muted.small.mb-1
                                    | Case Title

                                .fw-semibold.fs-5
                                    | #{caseRecord.case_title}


                            .col-12

                                .text-muted.small.mb-2
                                    | Request Summary

                                .p-3.bg-light.rounded
                                    | #{caseRecord.request_summary}
    //- Case Notes
    if hasPermission('view_case_note')
        .card.shadow-sm.mb-4

            .card-header.bg-white.py-3

                .d-flex.justify-content-between.align-items-center

                    h5.mb-0
                        i.bi.bi-journal-text.me-2
                        | Case Notes

                    a.btn.btn-sm.btn-outline-primary(
                        href=`/cases/${caseRecord.id}/notes`
                    )
                        i.bi.bi-journal-text.me-1
                        | View Notes

            .card-body

                .d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-center.gap-3

                    div
                        .text-muted.small
                            | Review and manage internal notes recorded for this Case.

                    if hasPermission('create_case_note') && !caseRecord.status_is_terminal
                        a.btn.btn-primary(
                            href=`/cases/${caseRecord.id}/notes/new`
                        )
                            i.bi.bi-plus-circle.me-2
                            | Add Case Note


    //- Case Reports
    if hasPermission('view_case_report')
        .card.shadow-sm.mb-4

            .card-header.bg-white.py-3

                .d-flex.justify-content-between.align-items-center

                    h5.mb-0
                        i.bi.bi-file-earmark-text.me-2
                        | Case Reports

                    a.btn.btn-sm.btn-outline-primary(
                        href=`/cases/${caseRecord.id}/reports`
                    )
                        i.bi.bi-file-earmark-text.me-1
                        | View Reports

            .card-body

                .d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-center.gap-3

                    div
                        .text-muted.small
                            | Review and manage investigation reports prepared for this Case.

                    if hasPermission('create_case_report') && !caseRecord.status_is_terminal
                        a.btn.btn-primary(
                            href=`/cases/${caseRecord.id}/reports/new`
                        )
                            i.bi.bi-plus-circle.me-2
                            | Create Case Report


    //- Case Documents
    if hasPermission('view_case_document')
        .card.shadow-sm.mb-4

            .card-header.bg-white.py-3

                .d-flex.justify-content-between.align-items-center

                    h5.mb-0
                        i.bi.bi-file-earmark-text.me-2
                        | Case Documents

                    .d-flex.gap-2

                        a.btn.btn-sm.btn-outline-primary(
                            href=`/cases/${caseRecord.id}/documents`
                        )
                            i.bi.bi-files.me-1
                            | View Documents

                        if hasPermission('create_case_document') && !caseRecord.status_is_terminal
                            a.btn.btn-sm.btn-primary(
                                href=`/cases/${caseRecord.id}/documents/new`
                            )
                                i.bi.bi-upload.me-1
                                | Upload Document

            .card-body

                .d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-center.gap-3

                    div
                        .text-muted.small
                            | Review and manage documents attached to this Case.

                    if hasPermission('create_case_document') && !caseRecord.status_is_terminal
                        span.badge.bg-light.text-dark.border
                            i.bi.bi-shield-lock.me-1
                            | Secure Case Storage


    //- Investigation Services
    .card.shadow-sm.mb-4

        .card-header.bg-white.py-3

            .d-flex.justify-content-between.align-items-center

                div
                    h5.mb-0
                        i.bi.bi-search.me-2
                        | Investigation Services

                if investigationServices
                    span.badge.bg-primary
                        | #{investigationServices.length}
                else
                    span.badge.bg-primary
                        | 0


        .card-body

            //- Add Investigation Service
            if hasPermission('update_case') && !caseRecord.status_is_terminal

                .mb-4

                    h6.fw-semibold.mb-3
                        i.bi.bi-plus-circle.me-2
                        | Add Investigation Service

                    if investigationTypes && investigationTypes.length > 0

                        form(
                            method="POST"
                            action=`/cases/${caseRecord.id}/services`
                        )

                            input(
                                type="hidden"
                                name="_csrf"
                                value=csrfToken
                            )

                            .row.g-3.align-items-end

                                .col-12.col-md-8

                                    label.form-label.fw-semibold(
                                        for="investigation_type_id"
                                    )
                                        | Investigation Type

                                    select.form-select(
                                        id="investigation_type_id"
                                        name="investigation_type_id"
                                        required
                                    )

                                        option(
                                            value=""
                                            selected=true
                                        )
                                            | Select an investigation type

                                        each type in investigationTypes

                                            option(
                                                value=type.id
                                            )
                                                | #{type.name}

                                    .form-text
                                        | Select the investigation service to add to this Case.


                                .col-12.col-md-4

                                    button.btn.btn-primary.w-100(
                                        type="submit"
                                    )
                                        i.bi.bi-plus-circle.me-2
                                        | Add Service

                    else

                        .alert.alert-warning.mb-0

                            i.bi.bi-exclamation-triangle.me-2
                            | No active investigation types are currently available.


            else if caseRecord.status_is_terminal

                .alert.alert-light.border.mb-4

                    i.bi.bi-lock.me-2
                    | Investigation services cannot be added because this Case has reached a terminal status.


            //- Existing Investigation Services
            if investigationServices && investigationServices.length > 0

                h6.fw-semibold.mb-3
                    | Current Services

                .row.g-3

                    each service in investigationServices

                        .col-12

                            .border.rounded.p-3

                                .d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-start.gap-3

                                    div

                                        .fw-semibold.fs-5
                                            | #{service.investigation_type_name}

                                        if service.investigation_type_code
                                            .small.text-muted
                                                | #{service.investigation_type_code}

                                        if service.investigation_type_description
                                            .small.text-muted.mt-1
                                                | #{service.investigation_type_description}

                                    div.text-md-end

                                        if service.service_status_is_terminal
                                            span.badge.bg-secondary
                                                | #{service.service_status_name}
                                        else
                                            span.badge.bg-primary
                                                | #{service.service_status_name}

                                        if service.assigned_to_username
                                            .small.text-muted.mt-2
                                                | Assigned to @#{service.assigned_to_username}
                                        else
                                            .small.text-muted.mt-2
                                                | Unassigned
                                        //- Investigation Service Assignment
                                        if hasPermission('assign_case') && !caseRecord.status_is_terminal && !service.service_status_is_terminal

                                            if investigators && investigators.length > 0

                                                form.mt-3(
                                                    method="POST"
                                                    action=`/cases/${caseRecord.id}/services/${service.id}/assign`
                                                )

                                                    input(
                                                        type="hidden"
                                                        name="_csrf"
                                                        value=csrfToken
                                                    )

                                                    .row.g-2.align-items-end

                                                        .col-12.col-md-8

                                                            label.form-label.small.fw-semibold(
                                                                for=`service_investigator_${service.id}`
                                                            )
                                                                | Investigator

                                                            select.form-select.form-select-sm(
                                                                id=`service_investigator_${service.id}`
                                                                name="investigator_id"
                                                                required
                                                            )

                                                                option(
                                                                    value=""
                                                                    selected=!service.assigned_to
                                                                )
                                                                    | Select investigator

                                                                each investigator in investigators

                                                                    option(
                                                                        value=investigator.id
                                                                        selected=Number(service.assigned_to) === Number(investigator.id)
                                                                    )
                                                                        | #{investigator.first_name} #{investigator.middle_name || ''} #{investigator.last_name} — @#{investigator.username}

                                                        .col-12.col-md-4

                                                            button.btn.btn-outline-primary.btn-sm.w-100(
                                                                type="submit"
                                                            )

                                                                i.bi.bi-person-check.me-2

                                                                if service.assigned_to
                                                                    | Reassign
                                                                else
                                                                    | Assign

                                            else

                                                .alert.alert-warning.mt-3.mb-0.small

                                                    i.bi.bi-exclamation-triangle.me-2
                                                    | No active investigators are currently available.


                                        //- Investigation Service Status
                                        if hasPermission('change_case_status') && !caseRecord.status_is_terminal && !service.service_status_is_terminal

                                            if serviceStatuses && serviceStatuses.length > 0

                                                form.mt-3(
                                                    method="POST"
                                                    action=`/cases/${caseRecord.id}/services/${service.id}/status`
                                                )

                                                    input(
                                                        type="hidden"
                                                        name="_csrf"
                                                        value=csrfToken
                                                    )

                                                    .row.g-2.align-items-end

                                                        .col-12.col-md-8

                                                            label.form-label.small.fw-semibold(
                                                                for=`service_status_${service.id}`
                                                            )
                                                                | Service Status

                                                            select.form-select.form-select-sm(
                                                                id=`service_status_${service.id}`
                                                                name="service_status_id"
                                                                required
                                                            )

                                                                option(
                                                                    value=""
                                                                    selected=true
                                                                )
                                                                    | Select service status

                                                                each status in serviceStatuses

                                                                    option(
                                                                        value=status.id
                                                                        selected=Number(service.service_status_id) === Number(status.id)
                                                                    )
                                                                        | #{status.name}

                                                        .col-12.col-md-4

                                                            button.btn.btn-outline-secondary.btn-sm.w-100(
                                                                type="submit"
                                                            )

                                                                i.bi.bi-arrow-repeat.me-2
                                                                | Change Status

                                            else

                                                .alert.alert-warning.mt-3.mb-0.small

                                                    i.bi.bi-exclamation-triangle.me-2
                                                    | No active service statuses are currently available.
                                hr.my-3

                                .row.g-3.small

                                    .col-6.col-md-3

                                        .text-muted
                                            | Display Order

                                        .fw-semibold
                                            | #{service.display_order}

                                    .col-6.col-md-3

                                        .text-muted
                                            | Started

                                        .fw-semibold

                                            if service.started_at
                                                | #{new Date(service.started_at).toLocaleDateString('en-NG')}
                                            else
                                                | —

                                    .col-6.col-md-3

                                        .text-muted
                                            | Completed

                                        .fw-semibold

                                            if service.completed_at
                                                | #{new Date(service.completed_at).toLocaleDateString('en-NG')}
                                            else
                                                | —

                                    .col-6.col-md-3

                                        .text-muted
                                            | Created

                                        .fw-semibold

                                            if service.created_at
                                                | #{new Date(service.created_at).toLocaleDateString('en-NG')}
                                            else
                                                | —

            else

                .text-center.py-4

                    i.bi.bi-search.fs-2.text-muted

                    p.text-muted.mb-0.mt-2
                        | No investigation services have been added to this Case.


        //- Assignment
        .card.shadow-sm.mb-4

            .card-header.bg-white.py-3

                h5.mb-0
                    i.bi.bi-person-badge.me-2
                    | Assignment

            .card-body

                if caseRecord.assigned_to_username

                    .d-flex.align-items-center

                        .rounded-circle.bg-primary.text-white.d-flex.align-items-center.justify-content-center.me-3(
                            style="width:48px;height:48px;"
                        )
                            i.bi.bi-person

                        div

                            .fw-semibold
                                | #{caseRecord.assigned_to_first_name || ''} #{caseRecord.assigned_to_middle_name || ''} #{caseRecord.assigned_to_last_name || ''}

                            .small.text-muted
                                | @#{caseRecord.assigned_to_username}

                            if caseRecord.assigned_to_email

                                .small.text-muted
                                    | #{caseRecord.assigned_to_email}

                else

                    .text-center.py-3

                        i.bi.bi-person-x.fs-2.text-muted

                        p.text-muted.mb-0.mt-2
                            | This Case is currently unassigned.


                //- Assignment controls
                if hasPermission('assign_case') && !caseRecord.status_is_terminal

                    hr.my-4

                    h6.fw-semibold.mb-3

                        if caseRecord.assigned_to_username
                            | Reassign Case
                        else
                            | Assign Case

                    if investigators && investigators.length > 0

                        form(
                            method="POST"
                            action=`/cases/${caseRecord.id}/assign`
                        )

                            input(
                                type="hidden"
                                name="_csrf"
                                value=csrfToken
                            )

                            .row.g-3.align-items-end

                                .col-12.col-md-8

                                    label.form-label.fw-semibold(
                                        for="investigator_id"
                                    )
                                        | Investigator

                                    select.form-select(
                                        id="investigator_id"
                                        name="investigator_id"
                                        required
                                    )

                                        option(
                                            value=""
                                            selected=!caseRecord.assigned_to
                                        )
                                            | Select an investigator

                                        each investigator in investigators

                                            option(
                                                value=investigator.id
                                                selected=Number(caseRecord.assigned_to) === Number(investigator.id)
                                            )
                                                | #{investigator.first_name} #{investigator.middle_name || ''} #{investigator.last_name} — @#{investigator.username}

                                    .form-text
                                        | Only active users with the investigator role are listed.

                                .col-12.col-md-4

                                    button.btn.btn-primary.w-100(
                                        type="submit"
                                    )

                                        i.bi.bi-person-check.me-2

                                        if caseRecord.assigned_to_username
                                            | Reassign Case
                                        else
                                            | Assign Case

                    else

                        .alert.alert-warning.mb-0

                            i.bi.bi-exclamation-triangle.me-2

                            | No active investigators are currently available for assignment.

                else if caseRecord.status_is_terminal

                    .alert.alert-light.border.mt-4.mb-0

                        i.bi.bi-lock.me-2

                        | Assignment cannot be changed because this Case has reached a terminal status.

                //- Status Management
                if hasPermission('change_case_status')

                    .card.shadow-sm.mb-4

                        .card-header.bg-white.py-3

                            h5.mb-0
                                i.bi.bi-arrow-repeat.me-2
                                | Change Case Status

                        .card-body

                            if caseRecord.status_is_terminal

                                .alert.alert-light.border.mb-0

                                    i.bi.bi-lock.me-2

                                    | This Case has reached a terminal status and cannot be moved to another status.

                            else if statuses && statuses.length > 0

                                form(
                                    method="POST"
                                    action=`/cases/${caseRecord.id}/status`
                                )

                                    input(
                                        type="hidden"
                                        name="_csrf"
                                        value=csrfToken
                                    )

                                    .row.g-3.align-items-end

                                        .col-12.col-md-8

                                            label.form-label.fw-semibold(
                                                for="status_id"
                                            )
                                                | Case Status

                                            select.form-select(
                                                id="status_id"
                                                name="status_id"
                                                required
                                            )

                                                option(
                                                    value=""
                                                    selected=true
                                                )
                                                    | Select a new status

                                                each status in statuses

                                                    option(
                                                        value=status.id
                                                        disabled=Number(status.id) === Number(caseRecord.case_status_id)
                                                    )
                                                        | #{status.name}

                                            .form-text
                                                | The current status cannot be selected again. Terminal statuses will close the Case.


                                        .col-12.col-md-4

                                            button.btn.btn-primary.w-100(
                                                type="submit"
                                            )
                                                i.bi.bi-arrow-repeat.me-2
                                                | Change Status

                            else

                                .alert.alert-warning.mb-0

                                    i.bi.bi-exclamation-triangle.me-2

                                    | No active Case statuses are currently available.


            //- Sidebar
            .col-12.col-xl-4

                //- Priority
                .card.shadow-sm.mb-4

                    .card-header.bg-white.py-3

                        h5.mb-0
                            i.bi.bi-exclamation-circle.me-2
                            | Priority

                    .card-body

                        if caseRecord.priority_name

                            .d-flex.align-items-center

                                i.bi.bi-flag-fill.fs-4.me-3

                                div

                                    .fw-semibold
                                        | #{caseRecord.priority_name}

                                    if caseRecord.severity_rank !== undefined
                                        .small.text-muted
                                            | Severity rank: #{caseRecord.severity_rank}


                        else

                            span.text-muted
                                | No priority assigned.


                        if hasPermission('change_case_priority') && !caseRecord.status_is_terminal

                            hr.my-4

                            h6.fw-semibold.mb-3
                                | Change Priority

                            if priorityLevels && priorityLevels.length > 0

                                form(
                                    method="POST"
                                    action=`/cases/${caseRecord.id}/priority`
                                )

                                    input(
                                        type="hidden"
                                        name="_csrf"
                                        value=csrfToken
                                    )

                                    .input-group

                                        select.form-select(
                                            name="priority_level_id"
                                            required
                                        )

                                            each priority in priorityLevels

                                                option(
                                                    value=priority.id
                                                    selected=Number(caseRecord.priority_level_id) === Number(priority.id)
                                                )
                                                    | #{priority.name}

                                        button.btn.btn-outline-primary(
                                            type="submit"
                                        )
                                            i.bi.bi-arrow-repeat.me-1
                                            | Change
                //- Status
                .card.shadow-sm.mb-4

                    .card-header.bg-white.py-3

                        h5.mb-0
                            i.bi.bi-arrow-repeat.me-2
                            | Status

                    .card-body

                        if caseRecord.status_name

                            .mb-2

                                if caseRecord.status_is_terminal
                                    span.badge.bg-secondary.fs-6
                                        | #{caseRecord.status_name}
                                else
                                    span.badge.bg-primary.fs-6
                                        | #{caseRecord.status_name}

                            if caseRecord.status_description
                                p.text-muted.small.mb-0
                                    | #{caseRecord.status_description}

                        else

                            span.text-muted
                                | No status information available.


                //- Case Dates
                .card.shadow-sm.mb-4

                    .card-header.bg-white.py-3

                        h5.mb-0
                            i.bi.bi-calendar3.me-2
                            | Case Timeline

                    .card-body

                        dl.row.mb-0

                            dt.col-sm-5.text-muted
                                | Opened

                            dd.col-sm-7
                                if caseRecord.opened_at
                                    | #{new Date(caseRecord.opened_at).toLocaleDateString('en-NG')}
                                else
                                    | —

                            dt.col-sm-5.text-muted
                                | Closed

                            dd.col-sm-7
                                if caseRecord.closed_at
                                    | #{new Date(caseRecord.closed_at).toLocaleDateString('en-NG')}
                                else
                                    | —

                            dt.col-sm-5.text-muted
                                | Created

                            dd.col-sm-7
                                if caseRecord.created_at
                                    | #{new Date(caseRecord.created_at).toLocaleDateString('en-NG')}
                                else
                                    | —

                            dt.col-sm-5.text-muted
                                | Updated

                            dd.col-sm-7
                                if caseRecord.updated_at
                                    | #{new Date(caseRecord.updated_at).toLocaleDateString('en-NG')}
                                else
                                    | —


                //- Created By
                .card.shadow-sm

                    .card-header.bg-white.py-3

                        h5.mb-0
                            i.bi.bi-person-plus.me-2
                            | Created By

                    .card-body

                        if caseRecord.created_by_username

                            .fw-semibold
                                | #{caseRecord.created_by_first_name || ''} #{caseRecord.created_by_middle_name || ''} #{caseRecord.created_by_last_name || ''}

                            .small.text-muted
                                | @#{caseRecord.created_by_username}

                        else

                            span.text-muted
                                | —
