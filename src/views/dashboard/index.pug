extends ../layouts/main

block content

    .row.justify-content-center.align-items-center.min-vh-100

        .col-12.col-lg-10

            .card.shadow.border-0.rounded-4

                .card-body.p-4.p-md-5

                    .d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-center.gap-3

                        div

                            h2.mb-2

                                i.bi.bi-speedometer2.me-2.text-primary

                                | Dashboard

                            p.lead.mb-0

                                | Welcome back,

                                strong
                                    |  #{sessionUser.firstName}

                                | !

                        form(
                            action="/logout"
                            method="POST"
                            class="m-0"
                        )

                            input(
                                type="hidden"
                                name="_csrf"
                                value=csrfToken
                            )

                            button.btn.btn-outline-danger(
                                type="submit"
                            )

                                i.bi.bi-box-arrow-right.me-2

                                | Sign Out

                    hr.my-4

                    p.text-muted.mb-0

                        | You have successfully signed in to the NDUKA platform.